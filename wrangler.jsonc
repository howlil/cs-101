{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cs-101",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "LEARNING_DB",
      "database_name": "cs101-learning",
      "database_id": "699ad067-2200-4e8c-a040-5ef3cc04fbb6"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
