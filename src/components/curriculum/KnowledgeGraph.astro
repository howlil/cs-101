---
import type { Concept, FocusedConcept } from '../../domain/learning-graph';
import { learningGraphHref } from '../../domain/learning-graph';
import { libraryHref } from '../../domain/content-library';
interface Props {
  view: FocusedConcept;
  concepts: Concept[];
  publishedLessonIds: string[];
}
const { view, concepts, publishedLessonIds } = Astro.props;
const published = new Set(publishedLessonIds);
const relationLabel = (type: string) =>
  type === 'requires' ? 'Prerequisite' : type === 'deepens' ? 'Deepens' : 'Related';
const applicationLabel = (role: string) =>
  ({ foundation: 'Foundation', application: 'Application', diagnostic: 'Diagnosis', operation: 'Operations' } as Record<string, string>)[role] ?? role;
---
<section class="knowledge-page" aria-label="Knowledge graph">
  <header class="knowledge-heading">
    <p class="knowledge-eyebrow">Graph-based learning · Curated pilot</p>
    <h1>Explore engineering concepts</h1>
    <p>Follow one concept across different engineering domains. Pilot connections are suggestions, not mandatory prerequisites.</p>
  </header>
  <nav class="knowledge-concepts" aria-label="Choose a concept">
    {concepts.map((concept) => (
      <a href={learningGraphHref(concept.id)}
        aria-current={concept.id === view.concept.id ? 'page' : undefined}
        class:list={['knowledge-chip', { 'is-active': concept.id === view.concept.id }]}>
        {concept.title}
      </a>
    ))}
  </nav>
  <section class="knowledge-map" aria-label="Focused concept and connections">
    <article class="knowledge-focus">
      <p class="knowledge-eyebrow">{view.concept.level} · Focused concept</p>
      <h2>{view.concept.title}</h2>
      <p>{view.concept.description}</p>
      <div class="knowledge-outcome">
        <strong>Learning outcome</strong>
        <span>{view.concept.objective}</span>
      </div>
    </article>
    <div class="knowledge-neighbors">
      <h3>Connected concepts</h3>
      {view.neighbors.length === 0 ? (
        <p class="knowledge-empty">No curated connections yet. Choose another concept above.</p>
      ) : (
        <nav aria-label="Connected concept links">
          {view.neighbors.map(({ concept, relation, direction }) => (
            <a class="knowledge-neighbor" href={learningGraphHref(concept.id)}>
              <span class="knowledge-relation">
                {relationLabel(relation.type)} · {relation.status === 'proposed' ? 'Suggested' : 'Reviewed'}
                {relation.type === 'requires' ? (direction === 'in' ? ' · Required before' : ' · Required by') : ''}
              </span>
              <strong>{concept.title}</strong>
              <span>{relation.rationale}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </section>
  <section class="knowledge-applications" aria-label="Learning material across domains">
    <div class="knowledge-section-heading">
      <h2>Learn across domains</h2>
      <span>{view.applications.length} curriculum units</span>
    </div>
    <div class="knowledge-unit-list">
      {view.applications.map((app) => (
        <a class="knowledge-unit" href={libraryHref(app.itemId)}>
          <span class="knowledge-unit-meta">{app.trackTitle} · {applicationLabel(app.role)}</span>
          <strong>{app.title}</strong>
          <span class="knowledge-unit-foot">{app.itemId} · {published.has(app.itemId) ? 'Full lesson available' : 'Curriculum outline only'}</span>
        </a>
      ))}
    </div>
  </section>
</section>
