---
import { resolveLibraryView, type LibraryView } from '../../domain/content-library';
interface Props { stage: 'understand' | 'practice' | 'evidence' }
const { stage } = Astro.props;
const section: Record<Props['stage'], { id: string; title: string; view: LibraryView }> = {
  understand: { id: 'materi', title: 'Materi', view: 'materi' },
  practice: { id: 'latihan', title: 'Latihan soal', view: 'soal' },
  evidence: { id: 'praktik', title: 'Praktik dan verifikasi mandiri', view: 'project' },
};
const current = resolveLibraryView(Astro.url.searchParams.get('view'), 'unit');
const selected = section[stage];
---
{current === selected.view && (
  <section class="library-content-section prose" id={selected.id} data-lesson-stage={stage} aria-label={selected.title}>
    <h2>{selected.title}</h2>
    <slot />
  </section>
)}
