---
interface Props { stage: 'understand' | 'practice' | 'evidence' }
const { stage } = Astro.props;
const section = {
  understand: { id: 'materi', title: 'Materi' },
  practice: { id: 'latihan', title: 'Latihan soal' },
  evidence: { id: 'praktik', title: 'Praktik dan verifikasi mandiri' },
}[stage];
---
<section class="library-content-section prose" id={section.id} data-lesson-stage={stage} aria-label={section.title}>
  <h2>{section.title}</h2>
  <slot />
</section>
