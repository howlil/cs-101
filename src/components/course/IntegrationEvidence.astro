---
import type { Criterion } from '../../domain/curriculum-v2/schema';
import { Textarea } from '../arc/textarea/textarea';
import { Button } from '../arc/button/button';
import Feedback from '../arc/Feedback';

interface Props {
  itemId: string;
  fingerprint: string;
  criteria: Criterion[];
  requirements: Criterion[];
  challengeCriterion: Criterion;
  revision: number;
  continueFrom?: string;
  lastAnchor?: string;
}

const {
  itemId,
  fingerprint,
  criteria,
  requirements,
  challengeCriterion,
  revision,
  continueFrom = '',
  lastAnchor = '',
} = Astro.props;
---
<form
  class="session-form integration-evidence-form"
  data-item-id={itemId}
  data-fingerprint={fingerprint}
  data-revision={revision}
>
  <section class="integration-evidence-section">
    <p class="eyebrow">EVIDENCE</p>
    <h2>Definition of Done</h2>
    <fieldset>
      <legend class="sr-only">Evidence definition of done</legend>
      {criteria.map((criterion) => (
        <Textarea
          label={criterion.text}
          name={`evidence:${criterion.id}`}
          rows={2}
          maxLength={8000}
        />
      ))}
    </fieldset>
  </section>

  {requirements.length > 0 && (
    <section class="integration-evidence-section">
      <p class="eyebrow">ARTIFACT</p>
      <h2>Output yang harus dibawa</h2>
      <fieldset>
        <legend class="sr-only">Evidence artifact integration</legend>
        {requirements.map((criterion) => (
          <Textarea
            label={criterion.text}
            name={`evidence:${criterion.id}`}
            rows={2}
            maxLength={8000}
          />
        ))}
      </fieldset>
    </section>
  )}

  <section class="integration-evidence-section">
    <p class="eyebrow">CHALLENGE</p>
    <h2>{challengeCriterion.text}</h2>
    <Textarea
      label="Bukti challenge"
      name={`evidence:${challengeCriterion.id}`}
      rows={3}
      maxLength={8000}
    />
  </section>

  <section class="integration-evidence-section">
    <Textarea
      label="Lanjut dari mana?"
      name="continueFrom"
      rows={3}
      maxLength={4000}
      defaultValue={continueFrom}
    />
    <input type="hidden" name="lastAnchor" value={lastAnchor} />
    <div class="actions">
      <Button type="submit" variant="primary" value="progress">Simpan sesi</Button>
      <Button type="submit" variant="secondary" value="passed">Ajukan integration selesai</Button>
    </div>
    <Feedback client:load scope={`session:${itemId}`} />
  </section>
</form>
