---
import { fingerprint, requiredEvidence, type Task } from '../../domain/curriculum';
import { Textarea } from '../arc/textarea/textarea';
import { Button } from '../arc/button/button';
import Feedback from '../arc/Feedback';
interface Props { task: Task; revision: number; continueFrom?: string; lastAnchor?: string }
const { task, revision, continueFrom = '', lastAnchor = '' } = Astro.props;
---
<form class="session-form" data-task-id={task.taskId} data-fingerprint={fingerprint(task)} data-revision={revision}>
  <h2 id="simpan-sesi">Simpan sesi</h2>
  <p class="muted small">Bukti dinilai mandiri. Simpan catatan untuk melanjutkan sesi berikutnya.</p>
  <fieldset><legend>Bukti per kriteria</legend>{requiredEvidence(task).map((criterion) => <Textarea label={criterion.text} name={`evidence:${criterion.id}`} rows={2} maxLength={8000} />)}</fieldset>
  <Textarea label="Lanjut dari mana?" name="continueFrom" rows={3} maxLength={4000} defaultValue={continueFrom} />
  <input type="hidden" name="lastAnchor" value={lastAnchor} />
  <div class="actions"><Button type="submit" variant="primary" value="progress">Simpan sesi</Button><Button type="submit" variant="secondary" value="passed">Ajukan lulus</Button></div>
  <Feedback client:load scope={`session:${task.taskId}`} />
</form>
