---
import type { Criterion } from '../../domain/curriculum-v2/schema';
import { Textarea } from '../arc/textarea/textarea';
import { Button } from '../arc/button/button';
import Feedback from '../arc/Feedback';

interface Props {
  itemId: string;
  fingerprint: string;
  criteria: Criterion[];
  revision: number;
  continueFrom?: string;
  lastAnchor?: string;
}

const {
  itemId,
  fingerprint,
  criteria,
  revision,
  continueFrom = '',
  lastAnchor = '',
} = Astro.props;
---
<form
  class="session-form"
  data-item-id={itemId}
  data-fingerprint={fingerprint}
  data-revision={revision}
>
  <h2 id="simpan-sesi">Simpan sesi</h2>
  <p class="muted small">Bukti dinilai mandiri. Simpan catatan untuk melanjutkan sesi berikutnya.</p>
  <fieldset>
    <legend>Bukti per kriteria</legend>
    {criteria.map((criterion) => (
      <Textarea
        label={criterion.text}
        name={`evidence:${criterion.id}`}
        rows={2}
        maxLength={8000}
      />
    ))}
  </fieldset>
  <Textarea
    label="Lanjut dari mana?"
    name="continueFrom"
    rows={3}
    maxLength={4000}
    defaultValue={continueFrom}
  />
  <input type="hidden" name="lastAnchor" value={lastAnchor} />
  <div class="actions">
    <Button type="submit" variant="primary" value="progress">Simpan sesi</Button>
    <Button type="submit" variant="secondary" value="passed">Ajukan lulus</Button>
  </div>
  <Feedback client:load scope={`session:${itemId}`} />
</form>
