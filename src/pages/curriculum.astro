---
import source from '../../curriculum/manifest.v2.json';
import AppLayout from '../layouts/AppLayout.astro';
import CurriculumPage from '../components/pages/CurriculumPage';
import { learning } from '../server/runtime';
import { buildCurriculumGraph } from '../domain/curriculum-v2/graph';
import {
  buildCurriculumSearchIndex,
  getItemConnections,
  getItemLocation,
  getTrackExplorer,
  itemHref,
} from '../domain/curriculum-v2/selectors';
import { getItemLearningView } from '../domain/learning/view-models';

const graph = buildCurriculumGraph(source);
const tracks = [...graph.manifest.tracks].sort((a, b) => a.order - b.order);
const integrations = graph.manifest.items
  .filter((item) => item.kind === 'integration')
  .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));

const requestedItemId = Astro.url.searchParams.get('item');
const requestedItem = requestedItemId ? graph.itemsById.get(requestedItemId) : undefined;
const requestedTrackId = Astro.url.searchParams.get('track');
const activeTrackId =
  requestedItem && requestedItem.kind !== 'integration'
    ? requestedItem.trackId
    : tracks.some((track) => track.id === requestedTrackId)
      ? requestedTrackId!
      : tracks[0]?.id;

const explorer = activeTrackId ? getTrackExplorer(graph, activeTrackId) : undefined;
const defaultItem = explorer?.modules.flatMap((module) => module.items)[0] ?? integrations[0];
const selectedItem = requestedItem ?? defaultItem;
const selectedLocation = selectedItem ? getItemLocation(graph, selectedItem.id) : undefined;
const selectedModuleId = selectedLocation?.module?.id;
const connections = selectedItem ? getItemConnections(graph, selectedItem.id) : undefined;
const searchIndex = buildCurriculumSearchIndex(graph);

let learningState: Awaited<ReturnType<Awaited<ReturnType<typeof learning>>['snapshot']>> | undefined;
try { learningState = await (await learning()).snapshot(); } catch { learningState = undefined; }

const viewFor = (id: string) => learningState ? getItemLearningView(graph, learningState, id) : undefined;
const stateFor = (id: string) => viewFor(id)?.displayState ?? 'unknown';

const explorerItem = (item: typeof graph.manifest.items[number]) => ({
  id: item.id,
  title: item.title,
  href: itemHref(graph, item.id),
  kind: item.kind,
  state: stateFor(item.id),
  active: item.id === selectedItem?.id,
});

const selectedView = selectedItem ? viewFor(selectedItem.id) : undefined;
const selected = selectedItem && selectedLocation ? {
  id: selectedItem.id,
  kind: selectedItem.kind,
  title: selectedItem.title,
  breadcrumb: [selectedLocation.track?.title ?? 'Cross-track', selectedLocation.module?.title].filter(Boolean).join(' / '),
  href: itemHref(graph, selectedItem.id),
  state: selectedView?.displayState,
  missingPrerequisites: selectedView?.missingPrerequisites ?? [],
  scope: selectedItem.kind === 'unit' || selectedItem.kind === 'integration' ? selectedItem.scope : undefined,
  challenge: selectedItem.kind === 'unit' || selectedItem.kind === 'integration' ? selectedItem.challenge : undefined,
  criteria: selectedItem.kind === 'unit' || selectedItem.kind === 'integration' ? selectedItem.criteria : undefined,
  problemStatement: selectedItem.kind === 'checkpoint' ? selectedItem.problemStatement : undefined,
  brief: selectedItem.kind === 'integration' ? selectedItem.brief : undefined,
  source: selectedItem.source,
  estimatedHours: selectedItem.estimatedMinutes ? Math.round(selectedItem.estimatedMinutes / 60 * 10) / 10 : undefined,
  prerequisites: (connections?.prerequisites ?? []).map((id) => {
    const item = graph.itemsById.get(id)!;
    return { id, title: item.title, href: itemHref(graph, id) };
  }),
} : undefined;
---
<AppLayout title="Materi" description="Browse curriculum CS-101 berdasarkan track, module, dan dependency." flush>
  <CurriculumPage
    client:load
    total={graph.manifest.items.length}
    activeTrackId={activeTrackId ?? ''}
    selectedModuleId={selectedModuleId}
    tracks={tracks.map((track) => ({
      id: track.id,
      title: track.title,
      total: graph.manifest.items.filter((item) => item.kind !== 'integration' && item.trackId === track.id).length,
    }))}
    modules={(explorer?.modules ?? []).map((module) => ({
      id: module.id,
      title: module.title,
      items: module.items.map(explorerItem),
    }))}
    integrations={integrations.map(explorerItem)}
    searchEntries={searchIndex.map((entry) => ({
      ...explorerItem(graph.itemsById.get(entry.itemId)!),
      searchText: entry.searchText,
    }))}
    selected={selected}
  />
</AppLayout>
