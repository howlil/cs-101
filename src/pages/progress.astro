---
import AppLayout from '../layouts/AppLayout.astro';
import { tasks } from '../server/curriculum';
import { learning } from '../server/runtime';
import { fingerprint } from '../domain/curriculum';
import EmptyAction from '../components/arc/EmptyAction';
import { Button } from '../components/arc/button/button';
import { Badge } from '../components/arc/badge/badge';
const state = await (await learning()).export();
---
<AppLayout title="Progres"><div class="content"><p class="eyebrow">BELAJAR / PROGRES</p><h1>Catatan kerja.</h1><p class="lede">Task, bukti, dan langkah yang sudah dikerjakan.</p>
  {tasks.length ? <ul class="task-list">{tasks.map((task) => {
    const progress = state.progress.find((item) => item.taskId === task.taskId);
    const label = progress?.status === 'passed' ? (progress.passedFingerprint === fingerprint(task) ? 'Lulus · mandiri' : 'Perlu validasi ulang') : state.activeTaskId === task.taskId ? 'Aktif' : 'Belum selesai';
    const tone = label === 'Lulus · mandiri' ? 'success' : label === 'Perlu validasi ulang' ? 'warning' : label === 'Aktif' ? 'info' : 'neutral';
    return <li><a href={`/learn/${task.taskId}`}><span class="task-code">{task.taskId}</span>{task.title}</a><Badge tone={tone} size="sm">{label}</Badge></li>;
  })}</ul> : <EmptyAction client:load title="Belum ada task." description="Daftar ini mengikuti curriculum yang ditambahkan." href="/demo" actionLabel="Lihat contoh tampilan" />}
  <h2>Riwayat sesi</h2>
  {state.sessions.length ? state.sessions.slice().reverse().map((session) => <article class="history-entry"><p class="small muted">{session.taskId} · <time datetime={session.recordedAt}>{session.recordedAt}</time></p><p>{session.continueFrom || 'Bukti tersimpan.'}</p>{session.evidence.map((item: { criterionId: string; text: string }) => <p><strong>{item.criterionId}</strong><br />{item.text}</p>)}</article>) : <EmptyAction client:load title="Belum ada sesi tersimpan." description="Catatan sesi akan tampil di sini setelah disimpan." />}
  <div class="actions"><form action="/api/export" method="get"><Button type="submit" variant="secondary">Ekspor progres</Button></form></div>
</div></AppLayout>
