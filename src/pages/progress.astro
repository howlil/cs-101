---
import AppLayout from '../layouts/AppLayout.astro';
import { tasks } from '../server/curriculum';
import { learning } from '../server/runtime';
import { fingerprint } from '../domain/curriculum';
const state = (await learning()).export();
---
<AppLayout title="Progres"><div class="content"><p class="eyebrow">BELAJAR / PROGRES</p><h1>Catatan kerja.</h1><p class="lede">Task, bukti, dan langkah yang sudah dikerjakan.</p>
  {tasks.length ? <ul class="task-list">{tasks.map((task) => {
    const progress = state.progress.find((item) => item.taskId === task.taskId);
    const label = progress?.status === 'passed' ? (progress.passedFingerprint === fingerprint(task) ? 'Lulus · mandiri' : 'Perlu validasi ulang') : state.activeTaskId === task.taskId ? 'Aktif' : 'Belum selesai';
    return <li><a href={`/learn/${task.taskId}`}><span class="task-code">{task.taskId}</span>{task.title}</a><span class="tag">{label}</span></li>;
  })}</ul> : <section class="empty"><h2>Belum ada task.</h2><p class="muted">Daftar ini mengikuti curriculum yang ditambahkan.</p><a href="/demo">Lihat contoh tampilan</a></section>}
  <h2>Riwayat sesi</h2>
  {state.sessions.length ? state.sessions.slice().reverse().map((session) => <article class="history-entry"><p class="small muted">{session.taskId} · <time datetime={session.recordedAt}>{session.recordedAt}</time></p><p>{session.continueFrom || 'Bukti tersimpan.'}</p>{session.evidence.map((item: { criterionId: string; text: string }) => <p><strong>{item.criterionId}</strong><br />{item.text}</p>)}</article>) : <p class="muted">Belum ada sesi tersimpan.</p>}
  <div class="actions"><a class="button" href="/api/export">Ekspor progres</a></div>
</div></AppLayout>
