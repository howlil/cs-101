---
import AppLayout from '../layouts/AppLayout.astro';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import EmptyAction from '../components/arc/EmptyAction';
import { Button } from '../components/arc/button/button';
import { itemHref } from '../domain/curriculum-v2/selectors';

const state = await (await learning()).export();
const passed = new Set(state.progress.filter((entry) => entry.status === 'passed').map((entry) => entry.itemId));
const progressById = new Map(state.progress.map((entry) => [entry.itemId, entry]));
const reviewById = new Map(state.reviews.map((entry) => [entry.itemId, entry]));
const tracks = [...curriculumGraph.manifest.tracks].sort((a, b) => a.order - b.order);
const actionableReviews = state.reviews
  .filter((review) =>
    (review.state === 'due' || review.state === 'retry') &&
    progressById.get(review.itemId)?.status === 'passed'
  )
  .map((review) => ({ review, item: curriculumGraph.itemsById.get(review.itemId) }))
  .filter((entry) => entry.item);
const integrations = curriculumGraph.manifest.items.filter((item) => item.kind === 'integration');

const reviewLabel = (itemId: string) => {
  const review = reviewById.get(itemId);
  if (!review) return '';
  if (review.state === 'due') return 'Review due';
  if (review.state === 'retry') return 'Review retry';
  if (review.state === 'retained') return 'Retained';
  return 'Review scheduled';
};
---
<AppLayout title="Progres">
  <div class="progress-page">
    <div class="content">
      <p class="eyebrow">BELAJAR / PROGRES</p>
      <h1>Posisi curriculum.</h1>
      <p class="lede">Completion berasal dari evidence. Review adalah retention state yang terpisah.</p>
    </div>

    {actionableReviews.length > 0 && (
      <section class="progress-review-queue">
        <div class="progress-section-heading">
          <div>
            <p class="eyebrow">ACTION</p>
            <h2>Review yang perlu dikerjakan</h2>
          </div>
          <span>{actionableReviews.length}</span>
        </div>
        <div class="progress-review-items">
          {actionableReviews.map(({ review, item }) => item && (
            <a href={'/review/' + item.id}>
              <code>{item.id}</code>
              <span>{item.title}</span>
              <small>{review.state === 'retry' ? 'Retry' : 'Due'}</small>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="progress-tracks">
      {tracks.map((track) => {
        const modules = [...curriculumGraph.modulesById.values()]
          .filter((module) => module.trackId === track.id)
          .sort((a, b) => a.order - b.order);
        const trackItems = curriculumGraph.manifest.items.filter(
          (item) => item.kind !== 'integration' && item.trackId === track.id,
        );
        const completed = trackItems.filter((item) => passed.has(item.id)).length;
        const trackReviewAction = trackItems.filter((item) => {
          const review = reviewById.get(item.id);
          return progressById.get(item.id)?.status === 'passed' &&
            (review?.state === 'due' || review?.state === 'retry');
        }).length;

        return (
          <section class="progress-track">
            <div class="progress-track-heading">
              <a href={'/curriculum?track=' + track.id}>{track.title}</a>
              <span>
                {completed}/{trackItems.length}
                {trackReviewAction ? ' · ' + trackReviewAction + ' review' : ''}
              </span>
            </div>
            <div class="progress-modules">
              {modules.map((module) => {
                const itemIds = curriculumGraph.moduleItems.get(module.id) ?? [];
                const done = itemIds.filter((id) => passed.has(id)).length;
                const active = itemIds.includes(state.activeItemId ?? '');
                const reviewCount = itemIds.filter((id) => {
                  const review = reviewById.get(id);
                  return progressById.get(id)?.status === 'passed' &&
                    (review?.state === 'due' || review?.state === 'retry');
                }).length;
                return (
                  <a href={'/curriculum?track=' + track.id + '&item=' + encodeURIComponent(itemIds[0] ?? '')}>
                    <span>{module.title}</span>
                    <small>
                      {active ? 'Aktif · ' : ''}
                      {done}/{itemIds.length}
                      {reviewCount ? ' · ' + reviewCount + 'R' : ''}
                    </small>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    {integrations.length > 0 && (
      <section class="progress-integrations">
        <div class="progress-section-heading">
          <div>
            <p class="eyebrow">CROSS-TRACK</p>
            <h2>Integration</h2>
          </div>
          <span>{integrations.filter((item) => passed.has(item.id)).length}/{integrations.length}</span>
        </div>
        <div class="progress-integration-items">
          {integrations.map((item) => {
            const progress = progressById.get(item.id);
            const review = reviewLabel(item.id);
            return (
              <a href={itemHref(curriculumGraph, item.id)}>
                <code>{item.id}</code>
                <span>{item.title}</span>
                <small>
                  {progress?.status === 'passed'
                    ? 'Lulus'
                    : progress?.status === 'stale'
                      ? 'Stale'
                      : state.activeItemId === item.id
                        ? 'Aktif'
                        : state.availability.find((entry) => entry.itemId === item.id)?.status ?? 'Belum'}
                  {review ? ' · ' + review : ''}
                </small>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="progress-history">
      <h2>Riwayat sesi</h2>
      {state.sessions.length ? (
        state.sessions.slice().reverse().map((session) => (
          <article class="history-entry">
            <p class="small muted">
              {session.itemId || session.taskId} · <time datetime={session.recordedAt}>{session.recordedAt}</time>
            </p>
            <p>{session.continueFrom || 'Evidence tersimpan.'}</p>
          </article>
        ))
      ) : (
        <EmptyAction
          client:load
          title="Belum ada sesi tersimpan."
          description="Catatan sesi akan tampil di sini setelah disimpan."
        />
      )}
    </section>

    <div class="actions">
      <form action="/api/export" method="get">
        <Button type="submit" variant="secondary">Ekspor progres</Button>
      </form>
    </div>
  </div>
</AppLayout>
