---
import AppLayout from '../layouts/AppLayout.astro';
import ProgressPage from '../components/pages/ProgressPage';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import { snapshotForRequest } from '../server/request-snapshot';
import { getProgressOverview, type ItemLearningView } from '../domain/learning/view-models';
import { reviewStateLabel } from '../lib/learning-language';

const service = await learning();
const [state, recentSessions] = await Promise.all([
  snapshotForRequest(Astro.locals),
  service.recentSessions(20),
]);
const overview = getProgressOverview(curriculumGraph, state);

const reviewLabel = (review: ItemLearningView['review']) => reviewStateLabel(review);

const stateLabel = (view: ItemLearningView) => {
  if (view.displayState === 'passed') return 'Selesai';
  if (view.displayState === 'stale') return 'Perlu diperbarui';
  if (view.displayState === 'active') return 'Sedang dikerjakan';
  if (view.displayState === 'started') return 'Pernah mulai';
  if (view.displayState === 'locked') return 'Terkunci';
  if (view.displayState === 'ready') return 'Siap';
  return 'Belum mulai';
};

const reviews = overview.actionableReviews.map(({ review, item }) => ({
  id: item.item.id,
  title: item.item.title,
  state: review.state === 'retry' ? 'retry' as const : 'due' as const,
}));

const tracks = overview.tracks.map((track) => ({
  ...track,
  modules: track.modules.map((module) => ({ ...module })),
}));

const integrations = overview.integrations.map((item) => ({
  id: item.item.id,
  title: item.item.title,
  href: item.href,
  stateLabel: stateLabel(item),
  reviewLabel: reviewLabel(item.review),
  passed: item.completion === 'passed',
}));

type ExportSession = {
  itemId?: string;
  taskId?: string;
  recordedAt: string;
  continueFrom?: string;
  kind?: string;
  minutes?: number;
  evidence?: unknown[];
  reflection?: Record<string, string>;
  blocker?: string;
};

const sessions = (recentSessions as ExportSession[])
  .map((session) => {
    const id = session.itemId || session.taskId || '';
    const item = curriculumGraph.itemsById.get(id);
    const reflection = session.reflection ?? {};
    const reflectionSummary =
      reflection.explainWithoutNotes ||
      reflection.evidenceChangedMind ||
      reflection.wrongAssumption ||
      reflection.tradeoffChosen ||
      reflection.monitorInProduction;

    return {
      id,
      title: item?.title ?? 'Item curriculum',
      recordedAt: session.recordedAt,
      continueFrom: session.continueFrom || '',
      kind: session.kind === 'passed' ? 'passed' as const : 'progress' as const,
      minutes: typeof session.minutes === 'number' ? session.minutes : undefined,
      evidenceCount: Array.isArray(session.evidence) ? session.evidence.length : 0,
      reflectionSummary,
      blocker: typeof session.blocker === 'string' ? session.blocker : undefined,
    };
  });
---
<AppLayout title="Progres">
  <ProgressPage
    reviews={reviews}
    tracks={tracks}
    integrations={integrations}
    sessions={sessions}
  />
</AppLayout>
