---
import AppLayout from '../layouts/AppLayout.astro';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import EmptyAction from '../components/arc/EmptyAction';
import { Button } from '../components/arc/button/button';

const state = await (await learning()).export();
const passed = new Set(state.progress.filter((entry) => entry.status === 'passed').map((entry) => entry.itemId));
const tracks = [...curriculumGraph.manifest.tracks].sort((a, b) => a.order - b.order);
---
<AppLayout title="Progres">
  <div class="content">
    <p class="eyebrow">BELAJAR / PROGRES</p>
    <h1>Posisi curriculum.</h1>
    <p class="lede">Completion berdasarkan evidence. Availability berasal dari prerequisite graph.</p>

    <div class="progress-tracks">
      {tracks.map((track) => {
        const modules = [...curriculumGraph.modulesById.values()]
          .filter((module) => module.trackId === track.id)
          .sort((a, b) => a.order - b.order);
        const trackItems = curriculumGraph.manifest.items.filter(
          (item) => item.kind !== 'integration' && item.trackId === track.id,
        );
        const completed = trackItems.filter((item) => passed.has(item.id)).length;

        return (
          <section class="progress-track">
            <div class="progress-track-heading">
              <a href={`/curriculum?track=${track.id}`}>{track.title}</a>
              <span>{completed}/{trackItems.length}</span>
            </div>
            <div class="progress-modules">
              {modules.map((module) => {
                const itemIds = curriculumGraph.moduleItems.get(module.id) ?? [];
                const done = itemIds.filter((id) => passed.has(id)).length;
                const active = itemIds.includes(state.activeItemId ?? '');
                return (
                  <a href={`/curriculum?track=${track.id}&item=${encodeURIComponent(itemIds[0] ?? '')}`}>
                    <span>{module.title}</span>
                    <small>{active ? 'Aktif · ' : ''}{done}/{itemIds.length}</small>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    <h2>Riwayat sesi</h2>
    {state.sessions.length ? (
      state.sessions.slice().reverse().map((session) => (
        <article class="history-entry">
          <p class="small muted">
            {session.itemId || session.taskId} · <time datetime={session.recordedAt}>{session.recordedAt}</time>
          </p>
          <p>{session.continueFrom || 'Evidence tersimpan.'}</p>
        </article>
      ))
    ) : (
      <EmptyAction
        client:load
        title="Belum ada sesi tersimpan."
        description="Catatan sesi akan tampil di sini setelah disimpan."
      />
    )}

    <div class="actions">
      <form action="/api/export" method="get">
        <Button type="submit" variant="secondary">Ekspor progres</Button>
      </form>
    </div>
  </div>
</AppLayout>
