---
import '../../styles/project.css';
import '../../styles/connections.css';
import AppLayout from '../../layouts/AppLayout.astro';
import ProjectPage from '../../components/pages/ProjectPage';
import { curriculumGraph } from '../../server/curriculum';
import { connectionGroupsForUI } from '../../lib/connection-view';
import { snapshotForRequest } from '../../server/request-snapshot';
import { getItemLearningView } from '../../domain/learning/view-models';
import { getItemActionState } from '../../domain/learning/item-action';
import {
  getItemConnections,
  getItemLocation,
  getProjectDelta,
  getProjectNavigation,
  itemHref,
} from '../../domain/curriculum-v2/selectors';

const project = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!project || project.kind !== 'checkpoint') return Astro.redirect('/404');

const location = getItemLocation(curriculumGraph, project.id);
const delta = getProjectDelta(curriculumGraph, project.id);
const navigation = getProjectNavigation(curriculumGraph, project.id);
const rawConnections = getItemConnections(curriculumGraph, project.id);
const contributors = rawConnections.incoming
  .filter((relation) => relation.type === 'contributes_to')
  .map((relation) => curriculumGraph.itemsById.get(relation.from))
  .filter((item): item is NonNullable<typeof item> => !!item);

const state = await snapshotForRequest(Astro.locals);
const progress = state.progress.find((entry) => entry.itemId === project.id);
const availability = state.availability.find((entry) => entry.itemId === project.id);
const active = state.activeItemId === project.id;
const passed = progress?.status === 'passed';
const actionState = getItemActionState(getItemLearningView(curriculumGraph, state, project.id));
const prerequisiteLinks = actionState.missingPrerequisites.map((id) => {
  const item = curriculumGraph.itemsById.get(id);
  return { id, title: item?.title ?? id, href: item ? itemHref(curriculumGraph, id) : '/curriculum' };
});
const inheritanceCriteria = delta.inheritanceClauses.length
  ? delta.inheritanceClauses
  : delta.inherited.filter((criterion) =>
      project.requirements.some((candidate) => candidate.id === criterion.id)
    );
const projectHref = (id: string) => '/project/' + encodeURIComponent(id);
---
<AppLayout title={project.title} description={project.problemStatement}>
  <ProjectPage
    client:load
    id={project.id}
    title={project.title}
    problemStatement={project.problemStatement}
    breadcrumb={[location.track?.title, location.module?.title].filter(Boolean).join(' / ')}
    curriculumHref={'/curriculum?track=' + encodeURIComponent(project.trackId) + '&item=' + encodeURIComponent(project.id)}
    fingerprint={project.fingerprint}
    passed={passed}
    active={active}
    ready={availability?.status === 'ready'}
    actionState={actionState}
    prerequisites={prerequisiteLinks}
    revision={state.revision}
    continueFrom={progress?.continueFrom}
    lastAnchor={progress?.lastAnchor}
    parent={navigation.parent ? { id: navigation.parent.id, title: navigation.parent.title, href: projectHref(navigation.parent.id) } : undefined}
    next={navigation.next ? { id: navigation.next.id, title: navigation.next.title, href: projectHref(navigation.next.id) } : undefined}
    contributors={contributors.map((item) => ({ id: item.id, title: item.title, href: itemHref(curriculumGraph, item.id) }))}
    newRequirements={delta.added}
    inherited={delta.inherited}
    inheritanceCriteria={inheritanceCriteria}
    inheritanceTitle={delta.parent ? 'Target dari ' + delta.parent.id : undefined}
    connections={connectionGroupsForUI(curriculumGraph, project.id)}
  />
</AppLayout>
