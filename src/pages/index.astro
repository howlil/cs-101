---
import AppLayout from '../layouts/AppLayout.astro';
import TodayPage from '../components/pages/TodayPage';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import { snapshotForRequest } from '../server/request-snapshot';
import { getTodayView } from '../domain/learning/view-models';
import { getItemLocation } from '../domain/curriculum-v2/selectors';

const state = await snapshotForRequest(Astro.locals);
const today = getTodayView(curriculumGraph, state);
const primary = today.primary;
const lastSession = primary ? (await (await learning()).recentSessions(1, primary.item.id))[0] : undefined;

const nextStepFor = (view: NonNullable<typeof primary>) => {
  if (view.continueFrom) return view.continueFrom;
  const item = view.item;
  if (item.kind === 'unit' || item.kind === 'integration') {
    return item.challenge.steps[0] ?? item.scope[0] ?? 'Buka materi dan kerjakan satu bagian kecil.';
  }
  return item.requirements[0]?.text ?? 'Buka project dan kerjakan target pertama.';
};

const primaryAction = primary
  ? today.primaryMode === 'continue' || primary.displayState === 'started'
    ? 'Lanjut belajar'
    : primary.displayState === 'stale'
      ? 'Perbarui & validasi'
      : primary.item.kind === 'unit'
        ? 'Mulai belajar'
        : 'Buka workspace'
  : '';

const primaryCard = primary ? (() => {
  const location = getItemLocation(curriculumGraph, primary.item.id);
  const blocker = typeof lastSession?.blocker === 'string' && lastSession.blocker.trim()
    ? lastSession.blocker.trim()
    : undefined;
  const breadcrumb = [location.track?.title ?? 'Lintas jalur', location.module?.title]
    .filter(Boolean)
    .join(' / ');
  const whyNext = today.primaryMode === 'continue'
    ? 'Melanjutkan sesi aktif.'
    : primary.item.prerequisites.length
      ? 'Prasyarat sudah terpenuhi.'
      : 'Item berikutnya yang siap di jalur ini.';
  const whyMatters = primary.item.kind === 'unit'
    ? primary.item.marketExpectation[0]
    : primary.item.kind === 'checkpoint'
      ? primary.item.problemStatement
      : primary.item.brief;

  return {
    id: primary.item.id,
    title: primary.item.title,
    description: primary.continueFrom || 'Item siap dikerjakan.',
    breadcrumb,
    nextStep: nextStepFor(primary),
    whyNext,
    whyMatters,
    blocker,
    href: primary.href,
    actionLabel: primaryAction,
  };
})() : undefined;

const reviewCard = today.nextReview ? {
  id: today.nextReview.item.item.id,
  title: today.nextReview.item.item.title,
  description: today.nextReview.review.state === 'retry'
    ? 'Recall sebelumnya belum cukup. Coba lagi tanpa catatan.'
    : 'Review sudah jatuh tempo.',
  href: '/review/' + today.nextReview.item.item.id,
  actionLabel: today.nextReview.review.state === 'retry' ? 'Ulangi review' : 'Mulai review',
} : undefined;
---
<AppLayout title="Hari ini">
  <TodayPage primary={primaryCard} review={reviewCard} reviewCount={today.actionableReviews.length} />
</AppLayout>
