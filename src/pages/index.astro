---
import AppLayout from '../layouts/AppLayout.astro';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import EmptyAction from '../components/arc/EmptyAction';
import TaskCard from '../components/arc/TaskCard';
import { getTodayView } from '../domain/learning/view-models';

const state = await (await learning()).snapshot();
const today = getTodayView(curriculumGraph, state);
const primary = today.primary;

const primaryDescription = primary
  ? today.primaryMode === 'continue'
    ? primary.continueFrom || 'Lanjutkan item aktif.'
    : primary.displayState === 'stale'
      ? 'Curriculum berubah. Validasi ulang item ini.'
      : primary.displayState === 'started'
        ? primary.continueFrom || 'Lanjutkan pekerjaan sebelumnya.'
        : 'Item berikutnya sudah siap dikerjakan.'
  : '';

const primaryAction = primary
  ? today.primaryMode === 'continue' || primary.displayState === 'started'
    ? 'Lanjutkan'
    : primary.displayState === 'stale'
      ? 'Validasi ulang'
      : 'Buka'
  : '';
---
<AppLayout title="Hari ini">
  <div class="content">
    <p class="eyebrow">BELAJAR / HARI INI</p>
    <h1>Lanjut dari sini.</h1>
    <p class="lede">Satu item. Satu langkah berikutnya.</p>

    {primary ? (
      <TaskCard
        taskId={primary.item.id}
        title={primary.item.title}
        description={primaryDescription}
        href={primary.href}
        actionLabel={primaryAction}
      />
    ) : (
      <EmptyAction
        client:load
        title="Tidak ada item yang siap."
        description="Periksa prerequisite di curriculum."
        href="/curriculum"
        actionLabel="Buka curriculum"
      />
    )}

    {today.nextReview ? (
      <section class="today-review">
        <div class="today-review-heading">
          <h2>Review</h2>
          {today.actionableReviews.length > 1 && <span>{today.actionableReviews.length} actionable</span>}
        </div>
        <TaskCard
          taskId={today.nextReview.item.item.id}
          title={today.nextReview.item.item.title}
          description={today.nextReview.review.state === 'retry' ? 'Retry recall diperlukan.' : 'Review sudah jatuh tempo.'}
          href={'/review/' + today.nextReview.item.item.id}
          actionLabel={today.nextReview.review.state === 'retry' ? 'Ulangi review' : 'Mulai review'}
        />
      </section>
    ) : (
      <p class="today-review-empty">Tidak ada review yang perlu dikerjakan sekarang.</p>
    )}

    <hr />
    <p class="muted small">Progres dihitung dari evidence. Review mengukur retention setelah completion.</p>
  </div>
</AppLayout>
