---
import { getCollection, render } from 'astro:content';
import AppLayout from '../layouts/AppLayout.astro';
import ContentLibrary from '../components/library/ContentLibrary.astro';
import EmptyCurriculum from '../components/library/EmptyCurriculum.astro';
import KnowledgeGraph from '../components/curriculum/KnowledgeGraph.astro';
import graphOverlay from '../../curriculum/learning-graph.v2.json';
import { buildLearningGraph, getFocusedConcept, conceptsForItem, assessmentForItem, getConceptNeighborhood } from '../domain/learning-graph';
import { curriculumGraph } from '../server/curriculum';
import { getLearningPath, getItemPathContext } from '../domain/learning-path';
import { planLearningGoal } from '../domain/learning-planner';
import { projectIdeaFor, selectLibraryItem, resolveLibraryView } from '../domain/content-library';
import { getItemLocation } from '../domain/curriculum-v2/selectors';
import '../styles/library.css';
import '../styles/knowledge-graph.css';

const learningGraph = buildLearningGraph(graphOverlay, curriculumGraph);
const isGraph = Astro.url.searchParams.get('mode') === 'graph';
const focusedConcept = getFocusedConcept(learningGraph, Astro.url.searchParams.get('concept'), Astro.url.searchParams.get('level'));
const learningPath = getLearningPath(learningGraph, focusedConcept);
const graphNeighborhood = getConceptNeighborhood(learningGraph, focusedConcept);
const selection = selectLibraryItem(
  curriculumGraph,
  Astro.url.searchParams.get('track'),
  Astro.url.searchParams.get('item'),
);
const item = selection.item;
const pathContext = item ? getItemPathContext(learningGraph, Astro.url.searchParams.get('concept'), Astro.url.searchParams.get('level'), item.id) : undefined;
const assessmentContext = pathContext && item
  ? assessmentForItem(learningGraph, pathContext.conceptId, pathContext.level, item.id)
  : undefined;
const view = item ? resolveLibraryView(Astro.url.searchParams.get('view'), item.kind) : 'materi';
const location = item ? getItemLocation(curriculumGraph, item.id) : undefined;
// Published status is derived from reviewed MDX, never from curriculum metadata alone.
const lessons = await getCollection('lessons', ({ data }) => !data.demo);
const publishedLessonIds = lessons.map((entry) => entry.data.taskId);
const goalPlan = planLearningGoal(learningGraph, {conceptId:focusedConcept.concept.id,level:focusedConcept.level},new Set(publishedLessonIds));
const lesson = item?.kind === 'unit'
  ? lessons.find((entry) => !entry.data.demo && entry.data.taskId === item.id)
  : undefined;
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const itemConcepts = item ? conceptsForItem(learningGraph, item.id) : [];
// Preserve a valid explicit path first; otherwise choose the first mapped G1 outcome.
const previewConcept = pathContext
  ? itemConcepts.find(concept => concept.id === pathContext.conceptId)
  : itemConcepts.find(concept => concept.outcomes.some(outcome => outcome.level === 'G1')) ?? itemConcepts[0];
const previewLevel = pathContext?.level ?? previewConcept?.outcomes.find(outcome => outcome.level === 'G1')?.level
  ?? previewConcept?.outcomes[0]?.level;
const preview = previewConcept && previewLevel
  ? getFocusedConcept(learningGraph, previewConcept.id, previewLevel)
  : undefined;
const graphPreview = preview?.outcome ? {
  focus: { id: preview.concept.id, title: preview.concept.title,
    href: '/?mode=graph&concept=' + encodeURIComponent(preview.concept.id) + '&level=' + preview.level },
  neighbors: preview.neighbors.map(({concept,relation,direction}) => ({
    id:concept.id,title:concept.title,
    href:'/?mode=graph&concept=' + encodeURIComponent(concept.id) + '&level=' + preview.level,
    relationType:relation.type,status:relation.status,direction,
  })),
  level:preview.level,
} : undefined;
const prerequisites = item?.prerequisites.map((id) => {
  const previous = curriculumGraph.itemsById.get(id);
  return { id, title: previous?.title ?? id };
}) ?? [];
---
<AppLayout title={isGraph ? 'Knowledge Graph' : item?.title ?? 'Materi engineering'} description="Kumpulan materi, latihan soal, dan ide project CS-101." publishedLessonIds={publishedLessonIds}>
  {isGraph ? (
    <KnowledgeGraph view={focusedConcept} path={learningPath} goalPlan={goalPlan} neighborhood={graphNeighborhood} concepts={learningGraph.concepts} publishedLessonIds={publishedLessonIds} />
  ) : item ? (
    <ContentLibrary
      item={item}
      trackTitle={location?.track?.title}
      moduleTitle={location?.module?.title}
      authored={Boolean(Content)}
      stale={Boolean(lesson && lesson.data.curriculumFingerprint !== item.fingerprint)}
      view={view}
      project={projectIdeaFor(curriculumGraph, item)}
      pathContext={pathContext}
      assessmentContext={assessmentContext}
      prerequisites={prerequisites}
      conceptLinks={itemConcepts.map(({ id, title }) => ({ id, title }))}
      graphPreview={graphPreview}
    >
      {Content && <Content />}
    </ContentLibrary>
   ) : <EmptyCurriculum />}
</AppLayout>
