---
import { getCollection, render } from 'astro:content';
import AppLayout from '../layouts/AppLayout.astro';
import ContentLibrary from '../components/library/ContentLibrary.astro';
import EmptyCurriculum from '../components/library/EmptyCurriculum.astro';
import { curriculumGraph } from '../server/curriculum';
import { projectIdeaFor, selectLibraryItem, resolveLibraryView } from '../domain/content-library';
import { getItemLocation } from '../domain/curriculum-v2/selectors';
import '../styles/library.css';

const selection = selectLibraryItem(
  curriculumGraph,
  Astro.url.searchParams.get('track'),
  Astro.url.searchParams.get('item'),
);
const item = selection.item;
const location = item ? getItemLocation(curriculumGraph, item.id) : undefined;
// Published status is derived from reviewed MDX, never from curriculum metadata alone.
const lessons = await getCollection('lessons', ({ data }) => !data.demo);
const publishedLessonIds = lessons.map((entry) => entry.data.taskId);
const lesson = item?.kind === 'unit'
  ? lessons.find((entry) => !entry.data.demo && entry.data.taskId === item.id)
  : undefined;
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const prerequisites = item?.prerequisites.map((id) => {
  const previous = curriculumGraph.itemsById.get(id);
  return { id, title: previous?.title ?? id };
}) ?? [];
---
<AppLayout title={item?.title ?? 'Materi engineering'} description="Kumpulan materi, latihan soal, dan ide project CS-101." publishedLessonIds={publishedLessonIds}>
  {item ? (
    <ContentLibrary
      item={item}
      trackTitle={location?.track?.title}
      moduleTitle={location?.module?.title}
      authored={Boolean(Content)}
      stale={Boolean(lesson && lesson.data.curriculumFingerprint !== item.fingerprint)}
      project={projectIdeaFor(curriculumGraph, item)}
      prerequisites={prerequisites}
    >
      {Content && <Content />}
    </ContentLibrary>
   ) : <EmptyCurriculum />}
</AppLayout>
