---
import AppLayout from '../layouts/AppLayout.astro';
import TodayPage from '../components/pages/TodayPage';
import { curriculumGraph } from '../server/curriculum';
import { learning } from '../server/runtime';
import { snapshotForRequest } from '../server/request-snapshot';
import { getTodayView } from '../domain/learning/view-models';
import { getItemLocation } from '../domain/curriculum-v2/selectors';
import { reviewBankFor } from '../server/review-bank';
import { assessedItemIds } from '../server/assessment-bank';
import { selectMicroRecallQueue } from '../domain/review/budget';

const state = await snapshotForRequest(Astro.locals);
const assessed = await learning();
const plans = await Promise.all(assessedItemIds().map((id) => assessed.assessmentPlan(id)));
const demonstratedItems = new Set(plans.filter((plan) => plan.kind === 'waiting').map((plan) => plan.itemId));
const today = getTodayView(curriculumGraph, state, demonstratedItems);
const primary = today.primary;
const primaryPlan = plans.find((plan) => plan.itemId === primary?.item.id);
// Review state remains authoritative; only current question banks generate actions.
const availableReviews = today.actionableReviews.filter(({ item }) => {
  const bank = reviewBankFor(item.item.id);
  return bank?.curriculumFingerprint === item.item.fingerprint;
});
const nextReview = availableReviews[0];
const microReviewQueue = selectMicroRecallQueue(plans);
const dueMicroRecall = microReviewQueue[0];
const lastSession = primary ? (await (await learning()).recentSessions(1, primary.item.id))[0] : undefined;

const nextStepFor = (view: NonNullable<typeof primary>) => {
  if (view.continueFrom) return view.continueFrom;
  const item = view.item;
  if (item.kind === 'unit' || item.kind === 'integration') {
    return item.challenge.steps[0] ?? item.scope[0] ?? 'Buka materi dan kerjakan satu bagian kecil.';
  }
  return item.requirements[0]?.text ?? 'Buka project dan kerjakan target pertama.';
};

// This CTA only navigates. Activation is a distinct server mutation on the
// item detail, so never promise to begin learning from this link.
const primaryAction = primary
  ? today.primaryMode === 'continue' ? 'Lanjut belajar'
    : primary.displayState === 'stale' ? 'Buka materi untuk perbarui'
    : primary.item.kind === 'unit' ? 'Buka materi'
    : primary.item.kind === 'checkpoint' ? 'Buka project'
    : 'Buka latihan gabungan'
  : '';

const primaryCard = primary ? (() => {
  const location = getItemLocation(curriculumGraph, primary.item.id);
  const blocker = typeof lastSession?.blocker === 'string' && lastSession.blocker.trim()
    ? lastSession.blocker.trim()
    : undefined;
  const breadcrumb = [location.track?.title ?? 'Lintas jalur', location.module?.title]
    .filter(Boolean)
    .join(' / ');
  const whyNext = today.primaryMode === 'continue'
    ? 'Melanjutkan sesi aktif.'
    : primary.item.prerequisites.length
      ? 'Prasyarat sudah terpenuhi.'
      : 'Item berikutnya yang siap di jalur ini.';
  const whyMatters = primary.item.kind === 'unit'
    ? primary.item.marketExpectation[0]
    : primary.item.kind === 'checkpoint'
      ? primary.item.problemStatement
      : primary.item.brief;

  return {
    id: primary.item.id,
    title: primary.item.title,
    description: primary.continueFrom || 'Item siap dikerjakan.',
    breadcrumb,
    nextStep: primaryPlan?.kind === 'practice' || primaryPlan?.kind === 'transfer'
      ? primaryPlan.question.prompt
      : primaryPlan?.kind === 'needs_support'
        ? 'Pahami kembali SQL NULL, lalu uji query dengan variasi berbeda.'
        : nextStepFor(primary),
    whyNext,
    whyMatters,
    blocker,
    href: primaryPlan?.kind === 'practice' || primaryPlan?.kind === 'transfer' || primaryPlan?.kind === 'needs_support'
      ? '/learn/' + primary.item.id + '#practice' : primary.href,
    actionLabel: primaryPlan?.kind === 'practice' ? 'Coba prediksi'
      : primaryPlan?.kind === 'transfer' ? 'Coba soal variasi'
      : primaryPlan?.kind === 'needs_support' ? 'Perkuat pemahaman'
      : primaryPlan?.kind === 'waiting' ? 'Lanjut implementasi'
      : primaryAction,
  };
})() : undefined;

const microRecallCard = dueMicroRecall?.kind === 'recall' ? {
  id: dueMicroRecall.itemId,
  title: curriculumGraph.itemsById.get(dueMicroRecall.itemId)?.title ?? dueMicroRecall.itemId,
  description: 'Satu prediksi singkat untuk menjaga pemahaman.',
  href: '/learn/' + dueMicroRecall.itemId + '#practice',
  actionLabel: 'Coba micro-recall',
} : undefined;

const reviewCard = nextReview ? {
  id: nextReview.item.item.id,
  title: nextReview.item.item.title,
  description: nextReview.review.state === 'retry'
    ? 'Recall sebelumnya belum cukup. Coba lagi tanpa catatan.'
    : 'Review sudah jatuh tempo.',
  href: '/review/' + nextReview.item.item.id,
  actionLabel: nextReview.review.state === 'retry' ? 'Ulangi review' : 'Mulai review',
} : undefined;
---
<AppLayout title="Hari ini">
  <TodayPage primary={primaryCard} review={microRecallCard ?? reviewCard}
    reviewCount={availableReviews.length + (microRecallCard ? 1 : 0)} />
</AppLayout>
