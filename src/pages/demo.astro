---
import { getEntry, render } from 'astro:content';
import AppLayout from '../layouts/AppLayout.astro';
import LessonPage from '../components/pages/LessonPage';

const lesson = await getEntry('lessons', 'demo');
if (!lesson) throw new Error('Demo lesson missing');
const { Content, headings } = await render(lesson);
---
<AppLayout title={lesson.data.title} description={lesson.data.description}>
  <LessonPage
    client:load
    itemId={lesson.data.taskId}
    title={lesson.data.title}
    description={lesson.data.description}
    available
    demo
    stale={false}
    active={false}
    revision={0}
    fingerprint={lesson.data.curriculumFingerprint ?? 'sha256:' + '0'.repeat(64)}
    criteria={[]}
    headings={headings}
    connections={[]}
    curriculumHref="/curriculum"
  >
    <Content />
  </LessonPage>
</AppLayout>
