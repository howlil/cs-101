---
import '../../styles/review.css';
import AppLayout from '../../layouts/AppLayout.astro';
import ReviewPage from '../../components/pages/ReviewPage';
import { curriculumGraph } from '../../server/curriculum';
import { snapshotForRequest } from '../../server/request-snapshot';
import { reviewBankFor } from '../../server/review-bank';
import { itemHref } from '../../domain/curriculum-v2/selectors';

const item = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!item) return Astro.redirect('/404');

const state = await snapshotForRequest(Astro.locals);
const progress = state.progress.find((entry) => entry.itemId === item.id);
const review = state.reviews.find((entry) => entry.itemId === item.id);
const bank = reviewBankFor(item.id);
const completion = progress?.status === 'passed'
  ? 'passed'
  : progress?.status === 'stale'
    ? 'stale'
    : 'other';
---
<AppLayout title={'Review · ' + item.title}>
  <ReviewPage
    client:load
    itemId={item.id}
    title={item.title}
    itemHref={itemHref(curriculumGraph, item.id)}
    completion={completion}
    review={review ? {
      state: review.state,
      step: review.step,
      dueAt: review.dueAt,
    } : undefined}
    bank={bank ? {
      version: bank.version,
      current: bank.curriculumFingerprint === item.fingerprint,
      questions: bank.questions.map(({ id, prompt, options }) => ({ id, prompt, options })),
    } : undefined}
    revision={state.revision}
  />
</AppLayout>
