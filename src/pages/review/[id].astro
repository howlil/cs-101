---
import AppLayout from '../../layouts/AppLayout.astro';
import { tasks } from '../../server/curriculum';
import EmptyAction from '../../components/arc/EmptyAction';
const task = tasks.find((item) => item.taskId === Astro.params.id);
if (!task) return Astro.redirect('/404');
---
<AppLayout title={`Review · ${task.title}`}><div class="content"><p class="eyebrow">{task.taskId} / REVIEW</p><h1>{task.title}</h1><EmptyAction client:load title="Review belum tersedia." description="Bank soal, penilaian, dan jadwal review belum diimplementasikan." href={`/learn/${task.taskId}`} actionLabel="Buka materi" /></div></AppLayout>
