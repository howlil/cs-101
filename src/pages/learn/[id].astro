---
import { getCollection, render } from 'astro:content';
import '../../styles/connections.css';
import AppLayout from '../../layouts/AppLayout.astro';
import LessonPage from '../../components/pages/LessonPage';
import { requiredEvidenceForItem } from '../../domain/learning/rules';
import { getConnectionGroups, getItemLocation, getTrackExplorer, itemHref } from '../../domain/curriculum-v2/selectors';
import { getItemLearningView } from '../../domain/learning/view-models';
import { getItemActionState } from '../../domain/learning/item-action';
import { mapLessonHeadings } from '../../domain/learning/lesson-headings';
import { curriculumGraph } from '../../server/curriculum';
import { connectionLabels } from '../../lib/learning-language';
import { snapshotForRequest } from '../../server/request-snapshot';

const item = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!item) return Astro.redirect('/404');
if (item.kind !== 'unit') return Astro.redirect('/curriculum?item=' + encodeURIComponent(item.id));

const lessons = await getCollection('lessons');
const lesson = lessons.find((entry) => entry.data.taskId === item.id && !entry.data.demo);
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const stale = !!lesson && lesson.data.curriculumFingerprint !== item.fingerprint;
const state = await snapshotForRequest(Astro.locals);
const progress = state.progress.find((entry) => entry.itemId === item.id);
const view = getItemLearningView(curriculumGraph, state, item.id);
const actionState = getItemActionState(view);
const location = getItemLocation(curriculumGraph, item.id);
const moduleItems = curriculumGraph.moduleItems.get(item.moduleId) ?? [];
const modulePosition = moduleItems.indexOf(item.id) + 1;
const trackItems = getTrackExplorer(curriculumGraph, item.trackId).modules.flatMap((module) => module.items);
const trackPosition = trackItems.findIndex((entry) => entry.id === item.id);
const before = trackPosition > 0 ? trackItems[trackPosition - 1] : undefined;
const after = trackPosition >= 0 ? trackItems[trackPosition + 1] : undefined;
const curriculumHref = '/curriculum?track=' + encodeURIComponent(item.trackId) + '&item=' + encodeURIComponent(item.id);
const prerequisites = view.missingPrerequisites.map((id) => {
  const entry = curriculumGraph.itemsById.get(id);
  return entry ? { id, title: entry.title, href: itemHref(curriculumGraph, id) } : { id, title: id, href: '/curriculum' };
});

const groups = getConnectionGroups(curriculumGraph, item.id);
const connections = [
  [connectionLabels.requires, groups.requires],
  [connectionLabels.usedLaterBy, groups.usedLaterBy],
  [connectionLabels.related, groups.related],
  [connectionLabels.deepDive, groups.deepDive],
  [connectionLabels.builtOnFoundation, groups.builtOnFoundation],
  [connectionLabels.foundationFor, groups.foundationFor],
  [connectionLabels.contributesTo, groups.contributesTo],
] as const;
const connectionData = connections
  .filter(([, entries]) => entries.length)
  .map(([label, entries]) => ({
    label,
    items: entries.map(({ item: target }) => ({
      id: target.id,
      title: target.title,
      href: itemHref(curriculumGraph, target.id),
    })),
  }));

const nextSmallStep =
  progress?.continueFrom ||
  item.challenge.steps[0] ||
  item.scope[0] ||
  'Buka bagian pertama dan buat satu catatan yang bisa diuji.';
---
<AppLayout title={item.title} description={lesson?.data.description}>
  <LessonPage
    client:load
    itemId={item.id}
    title={item.title}
    description={lesson?.data.description}
    marketExpectation={item.marketExpectation}
    nextSmallStep={nextSmallStep}
    estimatedMinutes={item.estimatedMinutes}
    scope={item.scope}
    challenge={item.challenge}
    source={item.source}
    available={Boolean(lesson && Content)}
    stale={stale}
    active={state.activeItemId === item.id}
    actionState={actionState}
    prerequisites={prerequisites}
    breadcrumb={{ track: location.track?.title ?? '', module: location.module?.title ?? '', position: modulePosition, total: moduleItems.length }}
    previous={before ? { id: before.id, title: before.title, href: itemHref(curriculumGraph, before.id) } : undefined}
    next={after ? { id: after.id, title: after.title, href: itemHref(curriculumGraph, after.id) } : undefined}
    reviewHref={view.review !== 'none' ? '/review/' + encodeURIComponent(item.id) : undefined}
    revision={state.revision}
    continueFrom={progress?.continueFrom}
    lastAnchor={progress?.lastAnchor}
    fingerprint={item.fingerprint}
    criteria={requiredEvidenceForItem(item)}
    headings={mapLessonHeadings(lesson?.body ?? '', rendered?.headings ?? [])}
    connections={connectionData}
    curriculumHref={curriculumHref}
  >
    {Content && <Content />}
  </LessonPage>
</AppLayout>
