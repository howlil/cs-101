---
import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import LessonPage from '../../components/pages/LessonPage';
import { requiredEvidenceForItem } from '../../domain/learning/rules';
import { getConnectionGroups, itemHref } from '../../domain/curriculum-v2/selectors';
import { curriculumGraph } from '../../server/curriculum';
import { learning } from '../../server/runtime';

const item = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!item) return Astro.redirect('/404');
if (item.kind !== 'unit') return Astro.redirect('/curriculum?item=' + encodeURIComponent(item.id));

const lessons = await getCollection('lessons');
const lesson = lessons.find((entry) => entry.data.taskId === item.id && !entry.data.demo);
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const stale = !!lesson && lesson.data.curriculumFingerprint !== item.fingerprint;
const state = await (await learning()).snapshot();
const progress = state.progress.find((entry) => entry.itemId === item.id);

const groups = getConnectionGroups(curriculumGraph, item.id);
const connections = [
  ['Requires', groups.requires],
  ['Used later by', groups.usedLaterBy],
  ['Related', groups.related],
  ['Deep dive', groups.deepDive],
  ['Built on foundation', groups.builtOnFoundation],
  ['Foundation for', groups.foundationFor],
  ['Contributes to', groups.contributesTo],
] as const;
const connectionData = connections
  .filter(([, entries]) => entries.length)
  .map(([label, entries]) => ({
    label,
    items: entries.map(({ item: target }) => ({
      id: target.id,
      title: target.title,
      href: itemHref(curriculumGraph, target.id),
    })),
  }));
---
<AppLayout title={item.title} description={lesson?.data.description}>
  <LessonPage
    client:load
    itemId={item.id}
    title={item.title}
    description={lesson?.data.description}
    available={Boolean(lesson && Content)}
    stale={stale}
    active={state.activeItemId === item.id}
    revision={state.revision}
    continueFrom={progress?.continueFrom}
    lastAnchor={progress?.lastAnchor}
    fingerprint={item.fingerprint}
    criteria={requiredEvidenceForItem(item)}
    headings={rendered?.headings ?? []}
    connections={connectionData}
    curriculumHref={'/curriculum?item=' + encodeURIComponent(item.id)}
  >
    {Content && <Content />}
  </LessonPage>
</AppLayout>
