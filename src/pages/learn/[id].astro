---
import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import LessonLayout from '../../layouts/LessonLayout.astro';
import SessionLogger from '../../components/course/SessionLogger.astro';
import { tasks } from '../../server/curriculum';
import { learning } from '../../server/runtime';
import { fingerprint } from '../../domain/curriculum';
const task = tasks.find((item) => item.taskId === Astro.params.id);
if (!task) return Astro.redirect('/404');
const lessons = await getCollection('lessons');
const lesson = lessons.find((item) => item.data.taskId === task.taskId && !item.data.demo);
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const stale = !!lesson && lesson.data.curriculumFingerprint !== fingerprint(task);
const state = (await learning()).snapshot();
const progress = state.progress.find((item) => item.taskId === task.taskId);
---
{lesson && Content ? <LessonLayout title={task.title} description={lesson.data.description} taskId={task.taskId} headings={rendered?.headings}>
  <div slot="before">
    {stale && <p class="notice">Materi perlu diperbarui. Bukti sebelumnya tetap tersimpan.</p>}
    {progress?.continueFrom && <p class="notice">Lanjut dari: {progress.continueFrom}</p>}
    {state.activeTaskId !== task.taskId && <div class="actions"><button class="primary" data-activate={task.taskId} data-revision={state.revision}>Jadikan task aktif</button><span role="status"></span></div>}
  </div>
  <Content />
  <div slot="after">{state.activeTaskId === task.taskId && <SessionLogger task={task} revision={state.revision} continueFrom={progress?.continueFrom} lastAnchor={progress?.lastAnchor} />}</div>
</LessonLayout> : <AppLayout title={task.title}><div class="content"><p class="eyebrow">{task.taskId}</p><h1>{task.title}</h1><section class="empty"><h2>Materi belum tersedia.</h2><p class="muted">Lesson untuk task ini belum dibuat.</p><a href="/progress">Kembali ke daftar task</a></section></div></AppLayout>}
