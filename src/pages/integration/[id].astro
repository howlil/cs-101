---
import '../../styles/integration.css';
import AppLayout from '../../layouts/AppLayout.astro';
import Feedback from '../../components/arc/Feedback';
import Connections from '../../components/curriculum/Connections.astro';
import IntegrationEvidence from '../../components/course/IntegrationEvidence.astro';
import { Button } from '../../components/arc/button/button';
import { curriculumGraph } from '../../server/curriculum';
import { learning } from '../../server/runtime';
import { requiredEvidenceForItem } from '../../domain/learning/rules';
import { itemHref } from '../../domain/curriculum-v2/selectors';

const integration = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!integration || integration.kind !== 'integration') return Astro.redirect('/404');

const state = await (await learning()).snapshot();
const progress = state.progress.find((entry) => entry.itemId === integration.id);
const availability = state.availability.find((entry) => entry.itemId === integration.id);
const active = state.activeItemId === integration.id;
const passed = progress?.status === 'passed';
const stale = progress?.status === 'stale';

const prerequisites = integration.prerequisites.map((id) => {
  const item = curriculumGraph.itemsById.get(id)!;
  const itemProgress = state.progress.find((entry) => entry.itemId === id);
  return {
    item,
    passed: itemProgress?.status === 'passed',
  };
});

const challengeCriterion = requiredEvidenceForItem(integration).find((entry) => entry.id === 'challenge')!;
---
<AppLayout title={integration.title} description={integration.brief}>
  <article class="integration-workspace">
    <header class="integration-header">
      <a class="integration-back" href="/curriculum">← Curriculum</a>
      <p class="eyebrow">CROSS-TRACK INTEGRATION</p>
      <div class="integration-kicker">
        <code>{integration.id}</code>
        <span>{integration.prerequisites.length} prerequisite</span>
      </div>
      <h1>{integration.title}</h1>
      <p class="integration-brief">{integration.brief}</p>

      <div class="integration-status-row">
        {passed ? (
          <span class="integration-state integration-state--passed">Lulus</span>
        ) : stale && !active ? (
          <>
            <span class="integration-state integration-state--stale">Perlu validasi ulang</span>
            {availability?.status === 'ready' && (
              <Button
                type="button"
                variant="primary"
                data-activate-item={integration.id}
                data-revision={state.revision}
              >
                Validasi ulang
              </Button>
            )}
          </>
        ) : active ? (
          <span class="integration-state integration-state--active">Aktif</span>
        ) : availability?.status === 'ready' ? (
          <Button
            type="button"
            variant="primary"
            data-activate-item={integration.id}
            data-revision={state.revision}
          >
            Mulai integration
          </Button>
        ) : (
          <span class="integration-state integration-state--locked">
            Terkunci · selesaikan {availability?.missingPrerequisites.join(', ') || 'prerequisite'}
          </span>
        )}
        <Feedback client:load scope={`activate:${integration.id}`} />
      </div>
    </header>

    <section class="integration-section">
      <div class="integration-section-heading">
        <div>
          <p class="eyebrow">READINESS</p>
          <h2>Cross-track prerequisite</h2>
        </div>
        <span>{prerequisites.filter((entry) => entry.passed).length}/{prerequisites.length}</span>
      </div>
      <div class="integration-prerequisites">
        {prerequisites.map(({ item, passed }) => (
          <a href={itemHref(curriculumGraph, item.id)}>
            <span class:list={['integration-prerequisite-state', { 'is-passed': passed }]} aria-hidden="true">
              {passed ? '✓' : '○'}
            </span>
            <code>{item.id}</code>
            <span>{item.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="integration-section">
      <p class="eyebrow">SCOPE</p>
      <h2>Apa yang diintegrasikan</h2>
      <ul class="integration-list">
        {integration.scope.map((scope) => <li>{scope}</li>)}
      </ul>
    </section>

    <section class="integration-section integration-challenge">
      <p class="eyebrow">CHALLENGE</p>
      <h2>{integration.challenge.title}</h2>
      {integration.challenge.steps.length > 0 && (
        <ol class="integration-list">
          {integration.challenge.steps.map((step) => <li>{step}</li>)}
        </ol>
      )}
    </section>

    <section class="integration-section">
      <div class="integration-section-heading">
        <div>
          <p class="eyebrow">DONE</p>
          <h2>Definition of Done</h2>
        </div>
        <span>{integration.criteria.length}</span>
      </div>
      <ol class="integration-list">
        {integration.criteria.map((criterion) => <li>{criterion.text}</li>)}
      </ol>
    </section>

    {integration.requirements.length > 0 && (
      <section class="integration-section">
        <div class="integration-section-heading">
          <div>
            <p class="eyebrow">OUTPUT</p>
            <h2>Artifact yang harus dibawa</h2>
          </div>
          <span>{integration.requirements.length}</span>
        </div>
        <ol class="integration-list">
          {integration.requirements.map((criterion) => <li>{criterion.text}</li>)}
        </ol>
      </section>
    )}

    <Connections graph={curriculumGraph} itemId={integration.id} />

    {active && !passed ? (
      <IntegrationEvidence
        itemId={integration.id}
        fingerprint={integration.fingerprint}
        criteria={integration.criteria}
        requirements={integration.requirements}
        challengeCriterion={challengeCriterion}
        revision={state.revision}
        continueFrom={progress?.continueFrom}
        lastAnchor={progress?.lastAnchor}
      />
    ) : !passed && (
      <section class="integration-section integration-evidence-placeholder">
        <p class="eyebrow">EVIDENCE</p>
        <h2>{availability?.status === 'ready' ? 'Aktifkan integration untuk mulai mencatat evidence.' : 'Evidence belum dapat dicatat.'}</h2>
        <p class="muted">
          {availability?.status === 'ready'
            ? 'Integration memakai active-item contract yang sama dengan unit dan project.'
            : 'Selesaikan seluruh hard prerequisite terlebih dahulu.'}
        </p>
      </section>
    )}
  </article>
</AppLayout>
