---
import '../../styles/integration.css';
import '../../styles/connections.css';
import AppLayout from '../../layouts/AppLayout.astro';
import IntegrationPage from '../../components/pages/IntegrationPage';
import { curriculumGraph } from '../../server/curriculum';
import { connectionLabels } from '../../lib/learning-language';
import { snapshotForRequest } from '../../server/request-snapshot';
import { requiredEvidenceForItem } from '../../domain/learning/rules';
import { getConnectionGroups, itemHref } from '../../domain/curriculum-v2/selectors';

const integration = curriculumGraph.itemsById.get(Astro.params.id ?? '');
if (!integration || integration.kind !== 'integration') return Astro.redirect('/404');

const state = await snapshotForRequest(Astro.locals);
const progress = state.progress.find((entry) => entry.itemId === integration.id);
const availability = state.availability.find((entry) => entry.itemId === integration.id);
const active = state.activeItemId === integration.id;
const passed = progress?.status === 'passed';
const stale = progress?.status === 'stale';
const prerequisites = integration.prerequisites.map((id) => {
  const item = curriculumGraph.itemsById.get(id)!;
  const itemProgress = state.progress.find((entry) => entry.itemId === id);
  return { id, title: item.title, href: itemHref(curriculumGraph, id), passed: itemProgress?.status === 'passed' };
});
const challengeCriterion = requiredEvidenceForItem(integration).find((entry) => entry.id === 'challenge')!;
const serializeConnections = (itemId: string) => {
  const groups = getConnectionGroups(curriculumGraph, itemId);
  const source = [
    [connectionLabels.requires, groups.requires],
    [connectionLabels.usedLaterBy, groups.usedLaterBy],
    [connectionLabels.related, groups.related],
    [connectionLabels.deepDive, groups.deepDive],
    [connectionLabels.builtOnFoundation, groups.builtOnFoundation],
    [connectionLabels.foundationFor, groups.foundationFor],
    [connectionLabels.contributesTo, groups.contributesTo],
  ] as const;
  return source
    .filter(([, items]) => items.length)
    .map(([label, items]) => ({
      label,
      items: items.map(({ item }) => ({
        id: item.id,
        title: item.title,
        href: itemHref(curriculumGraph, item.id),
      })),
    }));
};
---
<AppLayout title={integration.title} description={integration.brief}>
  <IntegrationPage
    client:load
    id={integration.id}
    title={integration.title}
    brief={integration.brief}
    fingerprint={integration.fingerprint}
    prerequisites={prerequisites}
    scope={integration.scope}
    challenge={integration.challenge}
    criteria={integration.criteria}
    requirements={integration.requirements}
    challengeCriterion={challengeCriterion}
    passed={passed}
    stale={stale}
    active={active}
    ready={availability?.status === 'ready'}
    missingPrerequisites={availability?.missingPrerequisites ?? []}
    revision={state.revision}
    continueFrom={progress?.continueFrom}
    lastAnchor={progress?.lastAnchor}
    connections={serializeConnections(integration.id)}
  />
</AppLayout>
