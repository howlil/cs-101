---
import '../styles/global.css';
import '../styles/app-shell.css';
import '../styles/curriculum.css';
import '../styles/connections.css';
import '../styles/integration.css';
import '../styles/project.css';
import '../styles/review.css';
import { ClientRouter } from 'astro:transitions';
import AppShell from '../components/app/AppShell';
import { curriculumGraph } from '../server/curriculum';
import { buildCurriculumSearchIndex, itemHref } from '../domain/curriculum-v2/selectors';

interface Props {
  title: string;
  description?: string;
  flush?: boolean;
}

const {
  title,
  description = 'Materi, latihan, dan bukti belajar CS-101.',
  flush = false,
} = Astro.props;

const path = Astro.url.pathname;
const navigationKey = Astro.url.pathname + Astro.url.search;
const searchEntries = buildCurriculumSearchIndex(curriculumGraph).map((entry) => ({
  ...entry,
  href: itemHref(curriculumGraph, entry.itemId),
}));

Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="id" data-accent="blue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · CS-101</title>
    <ClientRouter />
    <script is:inline>
      try {
        const preference = localStorage.getItem('cs101:theme') || 'system';
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
      } catch {}
    </script>
  </head>
  <body>
    <AppShell
      client:load
      transition:persist="cs101-app-shell"
      currentPath={path}
      navigationKey={navigationKey}
      flush={flush}
      searchEntries={searchEntries}
    >
      <slot />
    </AppShell>
  </body>
</html>
