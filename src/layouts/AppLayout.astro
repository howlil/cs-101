---
import '../styles/global.css';
import { tasks } from '../server/curriculum';
import { learning } from '../server/runtime';
interface Props { title: string; description?: string }
const { title, description = 'Materi, latihan, dan bukti belajar CS-101.' } = Astro.props;
const state = (await learning()).snapshot();
const path = Astro.url.pathname;
const tracks = [...new Set(tasks.map((task) => task.track))];
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · CS-101</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('cs101:theme') || 'system'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Langsung ke isi</a>
    <header class="topbar">
      <a class="brand" href="/">CS-101<span class="brand-sub">Catatan belajar</span></a>
      <nav aria-label="Navigasi utama">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Hari ini</a>
        <a href={state.activeTaskId ? `/learn/${state.activeTaskId}` : '/progress'} aria-current={path.startsWith('/learn/') || path === '/demo' ? 'page' : undefined}>Materi</a>
        <a href="/progress" aria-current={path === '/progress' ? 'page' : undefined}>Progres</a>
      </nav>
      <label class="theme-control"><span class="sr-only">Tema</span><select id="theme" aria-label="Tema"><option value="system">Sistem</option><option value="light">Terang</option><option value="dark">Gelap</option></select></label>
    </header>
    <div class="shell">
      <aside class="sidebar" aria-label="Daftar materi">
        <div class="eyebrow">WORKSPACE / CS-101</div>
        <details class="curriculum-menu" open>
          <summary>Curriculum</summary>
          <nav aria-label="Curriculum">
            {tracks.map((track) => <section class="track"><h2>{track}</h2>{tasks.filter((task) => task.track === track).map((task) => <a href={`/learn/${task.taskId}`} aria-current={path === `/learn/${task.taskId}` ? 'page' : undefined}><span class="task-code">{task.taskId}</span>{task.title}</a>)}</section>)}
            {!tasks.length && <p class="muted small">Belum ada task.</p>}
          </nav>
        </details>
        <div class="sidebar-bottom"><span class="eyebrow">REFERENSI</span><a href="/demo" aria-current={path === '/demo' ? 'page' : undefined}>Contoh tampilan <span class="tag">Demo</span></a><p class="muted small">Pahami. Praktikkan. Simpan bukti.</p></div>
      </aside>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <script>
      import '../scripts/learning';
      const theme = document.querySelector<HTMLSelectElement>('#theme');
      if (theme) {
        theme.value = document.documentElement.dataset.theme || 'system';
        theme.addEventListener('change', () => {
          document.documentElement.dataset.theme = theme.value;
          try { localStorage.setItem('cs101:theme', theme.value); } catch {}
        });
      }
    </script>
  </body>
</html>
