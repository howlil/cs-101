---
import '../styles/global.css';
import '../styles/app-shell.css';
import '../styles/app-sidebar.css';
import '../styles/curriculum.css';
import { ClientRouter, fade } from 'astro:transitions';
import { AppHeaderActions } from '../components/app/AppShell';
import AppSidebar, { type SidebarData } from '../components/app/AppSidebar';
import { curriculumGraph } from '../server/curriculum';
import { getTrackExplorer, getItemLocation } from '../domain/curriculum-v2/selectors';
import { libraryHref, selectLibraryItem } from '../domain/content-library';

interface Props { title: string; description?: string }
const { title, description = 'Materi, latihan soal, dan ide project CS-101.' } = Astro.props;
const graph = curriculumGraph;
const selection = selectLibraryItem(graph, Astro.url.searchParams.get('track'), Astro.url.searchParams.get('item'));
const current = selection.item;
const explorer = selection.trackId ? getTrackExplorer(graph, selection.trackId) : undefined;
const location = current ? getItemLocation(graph, current.id) : undefined;
const row = (item: typeof graph.manifest.items[number]) => ({
  id: item.id,
  title: item.title,
  href: libraryHref(item.id),
  kind: item.kind,
  active: current?.id === item.id,
});
const sidebarData: SidebarData = {
  total: graph.manifest.items.length,
  activeTrackId: selection.trackId,
  selectedModuleId: location?.module?.id,
  tracks: [...graph.manifest.tracks].sort((a, b) => a.order - b.order).map((track) => ({
    id: track.id,
    title: track.title,
    total: graph.manifest.items.filter((item) => item.kind !== 'integration' && item.trackId === track.id).length,
  })),
  modules: (explorer?.modules ?? []).map((module) => ({
    id: module.id,
    title: module.title,
    items: module.items.map(row),
  })),
  integrations: graph.manifest.items.filter((item) => item.kind === 'integration').map(row),
};
---
<!doctype html>
<html lang="id" data-accent="blue" data-density="compact" data-sidebar="expanded" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · CS-101</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      try {
        document.documentElement.dataset.sidebar = localStorage.getItem('cs101:sidebar-collapsed') === 'true' ? 'collapsed' : 'expanded';
        const preference = localStorage.getItem('cs101:theme') || 'system';
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
      } catch {}
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.sidebar = document.documentElement.dataset.sidebar || 'expanded';
        event.newDocument.documentElement.dataset.themePreference = document.documentElement.dataset.themePreference || 'system';
        event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme || 'light';
      });
    </script>
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main">Langsung ke konten</a>
    <header class="topbar" transition:persist="app-header">
      <a class="brand" href="/" aria-label="CS-101 · Materi">
        <span class="brand-mark" aria-hidden="true">CS</span><span>CS-101</span>
      </a>
      <AppHeaderActions client:load />
    </header>
    <div class="app-shell">
      <AppSidebar client:load data={sidebarData} />
      <main id="main" tabindex="-1" class="app-main" transition:name="page-workspace" transition:animate={fade({duration:'0.14s'})}>
        <slot />
      </main>
    </div>
  </body>
</html>
