---
import '../styles/global.css';
import '../styles/app-shell.css';
import '../styles/workspace.css';
import '../styles/curriculum.css';
import { AppHeader, AppNavigation } from '../components/app/AppShell';
import NavigationProgress from '../components/app/NavigationProgress';
import ContextualCurriculumSidebar from '../components/curriculum/ContextualCurriculumSidebar';
import { ClientRouter, fade } from 'astro:transitions';
import type { ContextualCurriculumData } from '../components/curriculum/ContextualCurriculumSidebar';
import { curriculumGraph, curriculumSearchIndex, curriculumSearchEntries } from '../server/curriculum';
import { snapshotForRequest } from '../server/request-snapshot';
import type { LearningSnapshot } from '../server/learning';
import {
  getItemLocation,
  getTrackExplorer,
  itemHref,
} from '../domain/curriculum-v2/selectors';
import { getItemLearningView } from '../domain/learning/view-models';

interface Props {
  title: string;
  description?: string;
  flush?: boolean;
}

const {
  title,
  description = 'Materi, latihan, dan bukti belajar CS-101.',
  flush = false,
} = Astro.props;

const path = Astro.url.pathname;
const searchIndex = curriculumSearchIndex;
const searchEntries = curriculumSearchEntries;

let contextualExplorer: ContextualCurriculumData | undefined;
const contextualMatch = path.match(/^\/(learn|project|integration)\/([^/]+)$/);

if (contextualMatch) {
  const currentItemId = decodeURIComponent(contextualMatch[2]);
  const currentItem = curriculumGraph.itemsById.get(currentItemId);

  if (currentItem) {
    const tracks = [...curriculumGraph.manifest.tracks].sort((a, b) => a.order - b.order);
    const integrations = curriculumGraph.manifest.items
      .filter((item) => item.kind === 'integration')
      .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));

    const location = getItemLocation(curriculumGraph, currentItem.id);
    let activeTrackId = location.track?.id;

    if (!activeTrackId && currentItem.kind === 'integration') {
      const anchor = currentItem.prerequisites
        .map((id) => curriculumGraph.itemsById.get(id))
        .find((item) => item && item.kind !== 'integration');
      activeTrackId = anchor && anchor.kind !== 'integration' ? anchor.trackId : tracks[0]?.id;
    }

    let learningState: LearningSnapshot | undefined;
    try { learningState = await snapshotForRequest(Astro.locals); } catch { learningState = undefined; }

    const stateFor = (id: string) =>
      learningState ? getItemLearningView(curriculumGraph, learningState, id).displayState : 'unknown';

    const explorerItem = (item: typeof curriculumGraph.manifest.items[number]) => ({
      id: item.id,
      title: item.title,
      href: itemHref(curriculumGraph, item.id),
      kind: item.kind,
      state: stateFor(item.id),
      active: item.id === currentItem.id,
    });

    const explorer = activeTrackId ? getTrackExplorer(curriculumGraph, activeTrackId) : undefined;

    contextualExplorer = {
      total: curriculumGraph.manifest.items.length,
      activeTrackId: activeTrackId ?? '',
      selectedModuleId: location.module?.id,
      tracks: tracks.map((track) => ({
        id: track.id,
        title: track.title,
        total: curriculumGraph.manifest.items.filter(
          (item) => item.kind !== 'integration' && item.trackId === track.id,
        ).length,
      })),
      modules: (explorer?.modules ?? []).map((module) => ({
        id: module.id,
        title: module.title,
        items: module.items.map(explorerItem),
      })),
      integrations: integrations.map(explorerItem),
      searchEntries: searchIndex.map((entry) => ({
        ...explorerItem(curriculumGraph.itemsById.get(entry.itemId)!),
        searchText: entry.searchText,
      })),
    };
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="id" data-accent="blue" data-density="compact">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · CS-101</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      // The new SSR document defaults to light. Copy the current preference
      // before the DOM swap to avoid a theme flash during client navigation.
      try {
        const preference = localStorage.getItem('cs101:theme') || 'system';
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
      } catch {}
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.themePreference =
          document.documentElement.dataset.themePreference || 'system';
        event.newDocument.documentElement.dataset.theme =
          document.documentElement.dataset.theme || 'light';
      });
    </script>
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main">Langsung ke isi</a>
    <AppHeader client:load transition:persist="app-header" searchEntries={searchEntries} />
    <div class:list={['app-shell', contextualExplorer && 'app-shell--with-context']}>
      <AppNavigation currentPath={path} />
      {contextualExplorer && <ContextualCurriculumSidebar client:load data={contextualExplorer} />}
      <main
        id="main"
        tabindex="-1"
        class:list={['app-main', flush && 'app-main--flush']}
        transition:name="page-workspace"
        transition:animate={fade({ duration: '0.14s' })}
      >
        <slot />
      </main>
    </div>
    <NavigationProgress client:load transition:persist="navigation-progress" />
  </body>
</html>
